# Endo AI — environment variables
# Copy to .env and fill in. (Supersedes .env.template — this is the full list.)

# ── Required ─────────────────────────────────────────────
# Claude synthesis — get from console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here
# Neon Postgres with pgvector — library, query cache, abstract cache
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Optional providers ───────────────────────────────────
# OpenAI: TTS narration + GPT-4o vision fallback for X-ray analysis
OPENAI_API_KEY=
# Narration voice. OpenAI TTS is the primary engine whenever OPENAI_API_KEY is
# set; gTTS is the fallback only. onyx is the chosen professional lecture voice
# — level and unhurried over long clinical prose. Other options: alloy, ash,
# ballad, coral, echo, fable, nova, sage, shimmer, verse. An unrecognised value
# falls back to onyx rather than failing the export.
TTS_VOICE=onyx
# Speech model. tts-1-hd ($30/1M chars) is the default; tts-1 ($15/1M chars)
# halves narration cost at slightly lower fidelity. Logged per call to
# cost_log.jsonl.
TTS_MODEL=tts-1-hd
# Gemini: primary vision provider for X-ray analysis
GEMINI_API_KEY=
# NCBI eutils: raises rate limit 3 -> 10 req/s and identifies the caller
NCBI_API_KEY=
NCBI_EMAIL=

# ── Admin auth (WORKLIST 4.1) ────────────────────────────
# Shared secret for /admin/costs, /admin/evidence-mapping, POST /cache/clear.
# Requests must send it as the X-Admin-Token header. UNSET = those routes
# return 403 for everyone (deny by default, never fail open).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ── X-ray vision path (WORKLIST 4.4) ─────────────────────
# OFF by default. Patient radiographs are PHI: enabling this in production
# requires a BAA with the vision provider (Gemini/OpenAI). See HANDOVER.md.
ENABLE_XRAY=false

# ── Feature flags / tuning (defaults are fine) ───────────
# LIBRARY_WRITE_BACK=      write live results back into the library
# USE_IMPACT_FACTOR=       include IF in scoring (default off, PRISMA grounds)
# CITATION_SUPPORT_CHECK=  claim-vs-abstract support check
# CACHE_EQUIVALENCE_CHECK= semantic cache-hit equivalence check
# DB_POOL_MIN= / DB_POOL_MAX=   Postgres connection pool bounds
