# ── Secrets (NEVER commit) ───────────────────────────────
.env
.env.*
!.env.template
provider_profile.json
.gitconfig

# ── Claude Code local files ──────────────────────────────
.claude.json
.claude.json.backup
.claude/settings.local.json
.claude/scheduled_tasks.lock

# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# ── Generated media / large binaries (76 MB+) ────────────
generated_media/
media_index.json
*.mp4
*.mp3
*.wav

# ── Runtime logs & data dumps ────────────────────────────
cost_log.jsonl
_test_cost_log*.jsonl
pubmed_audit.jsonl
evidence_mapping.jsonl
flask_err.txt
flask_out.txt
audit_logs/
answers/
learn_history/

# ── Test artifacts ───────────────────────────────────────
presentations/*.pptx
presentations/test_*.pptx

# ── OS noise ─────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store

# ── Pitch / business material (not code) ─────────────────
# Curo_Deck.pptx is a ~3MB binary regenerated wholesale on every revision;
# versioning it would bloat history for no diffable benefit. The generated
# HTML pitch draft is superseded by it. System documentation lives in docs/.
*.pptx
pitch_deck.html

# ── Theme backup ─────────────────────────────────────────
# Redundant with git history — the original dark theme is in the initial commit.
templates/index.dark-theme.bak.html
static/curo-logo-full.png
slide_specs/

# Pinned evidence bases for scripts/capture_attempt1.py. Regenerate with
# `--pin`; they are pickles of live retrieval results, which is a fine cache
# and a bad archival format — the measurements they produced are committed as
# JSON in eval/logs/ and those are the durable record.
eval/logs/pinned_evidence/

# A13c degradation telemetry — runtime log, like the other audit trails
term_degradation.jsonl

# A49 item 1 — untyped-abstract working cache. Derived data, 3.2MB of
# PubMed abstracts, regenerated by scripts/collect_untyped_abstracts.py and
# scripts/measure_design_all29.py. The negative-control fixture is committed;
# the bulk is not.
eval/reports/untyped_abstract_cache/*
!eval/reports/untyped_abstract_cache/control_42388091.json
